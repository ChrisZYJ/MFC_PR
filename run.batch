#!/usr/bin/env bash
#SBATCH --job-name="bench"
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --time=23:59:00
#SBATCH --partition="rm"
#SBATCH --output="bench%j.out"
#SBATCH --error="bench%j.err"
#SBATCH --export=ALL
#SBATCH --exclusive
# #SBATCH --mem=250G
#SBATCH --mem=250G

module purge
source ~/.bashrc
module load gcc/9.3.0
module load openmpi-2.0/gcc-9.3.0

./mfc.sh run case/bench_test_fix/case.py -t pre_process simulation -N 1 -n 16 -b mpirun
./mfc.sh run case/bench_test_fix/case.py -t post_process -N 1 -n 1 -b mpirun